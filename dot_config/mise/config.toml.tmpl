[tools]
{{- if eq .chezmoi.os "linux" }}
"github:fish-shell/fish-shell" = "latest"   # macOS: brew install fish
{{- end }}
herdr = "latest"
claude = "latest"
neovim = "latest"
lazygit = "latest"
ripgrep = "latest"
fd = "latest"
delta = "latest"
node = "lts"
uv = "latest"
gh = "latest"
{{- if not .work }}
rust = { version = "stable", components = "rust-analyzer,clippy,rustfmt" }
typst = "latest"
{{- end }}

[settings]
experimental = true
